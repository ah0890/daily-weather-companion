<?xml version="1.0" encoding="utf-8"?>
<!--
    HTTPS only, trusting the system's certificate authorities and never user-installed ones, so
    forecasts can't be read or altered by a proxy on the network or on the device.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
